# ============================================================
#  FreedomForge AI — .gitignore
# ============================================================

# Models — never commit these, they are huge
models/
*.gguf
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environment
venv/
env/
ENV/
.venv/

# Config — contains user preferences, not shared
config.json
.forge_key
crash_reports/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temp
tmp/
temp/
.tmp/

# Distribution
*.tar.gz
*.zip
*.deb
*.dmg
*.exe
*.AppImage
